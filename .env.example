# The entire story is playable without cloud calls.
PORT=8795
DIALOGUE_PROVIDER=authored

# Optional local Bedrock dialogue: use an existing AWS CLI profile.
# Never put access keys in this file or in browser code.
AWS_PROFILE=codex-tart
AWS_REGION=us-east-1
BEDROCK_REGION=us-east-1
BEDROCK_MODEL=us.anthropic.claude-sonnet-4-5-20250929-v1:0
# Set DIALOGUE_PROVIDER=bedrock to enable it locally.
